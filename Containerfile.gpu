# TankBind on the GPU — this model could not simply be given a CUDA wheel.
#
# The CPU tier pins pytorch 1.13.1 and python 3.8 because torchdrug 0.1.2 does. torch 1.13's
# cu117 build predates Ada and ships no sm_89 kernels, so on an Ada card (sm_89) it does not
# run at all — this was a port, not a rebuild.
#
# What moved:
#   python 3.8 -> 3.10              3.8 is EOL
#   pytorch 1.13.1 -> 2.5.1         2.1.x was the first line with native sm_86 and sm_89 support;
#                                   2.5.1 became possible once the compiled PyG extensions went
#   pyg 2.1.0 -> current            2.1.0 has no wheels for torch 2.x
#   torchdrug -> removed entirely   see below
#
# torchdrug was what welded the old pins together: `feature_utils.py` built the ligand
# features through `torchdrug.data`, so it sat on the embedding path. It is now gone —
# `tankbind_features.py` reimplements its two feature functions in RDKit, and GATv2/GINv2
# use torch's own scatter and sparse ops. Verified bit-identical: `compare_featurizer.py`
# matches its arrays on 30 core-set complexes, and full embeddings agree to max|Δ| = 0.
#
# RDKit still needs pinning even so — see the note on the install below.
FROM docker.io/mambaorg/micromamba:1.5.8

USER root
ENV PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1 MPLBACKEND=Agg

RUN micromamba install -y -n base -c conda-forge \
        # rdkit pinned to the reference tier's version, not left to float. The bond stereo
        # one-hot is sized by len(Chem.BondStereo.values), which went from 6 to 8 between
        # RDKit generations: 2022.09.5 yields 19-dimensional bond features and 2024.03.5
        # yields 21. Both are shapes the adapter accepts, so a mismatch would not error — it
        # would quietly featurise differently from the recorded run. The reimplementation
        # inherits this from RDKit exactly as torchdrug did.
        python=3.10 "rdkit=2024.03.5" biopython freesasa h5py python-lmdb \
        # mkl 2024.1 dropped the iJIT_NotifyEvent symbol and breaks `import torch`; the CPU
        # tier hit this too and the constraint survives the version bump
        "mkl<2024" \
        libstdcxx-ng \
    && micromamba clean --all --yes
ENV PATH=/opt/conda/bin:${PATH}
ENV LD_LIBRARY_PATH=/opt/conda/lib

RUN pip install --no-cache-dir torch==2.5.1

# **No compiled PyG extensions, and therefore no torch pin.** torch_scatter, torch_sparse and
# torch_cluster used to come from a per-torch wheel index here, which is what held this tier at
# 2.1.2: each is built against one torch ABI, so the image could only ever be as new as the
# last published wheel. PyG dropped the hard dependency in 2.4.
#
# Only `torch_scatter` was ever on the code path — `gvp/__init__.py`, `GATv2.py`, `GINv2.py`
# and an unused import in `model.py`. All four now go through `tankbind/scatter_ops.py`, which
# wraps `torch_geometric.utils.scatter` and reproduces `scatter_max`'s tuple return. The other
# two were pulled in by PyG opportunistically, never by this port.
#
# `torch_cluster` is still imported by `gvp/data.py` and `gvp/atom3d.py`. Neither is on any
# path this model uses — importing `model` loads `gvp` and nothing under it — so they are
# left as the authors wrote them and are simply not importable here. They implement atom3d
# tasks, not TankBind.
RUN pip install --no-cache-dir torch_geometric

# No torchdrug. It used to be here for one call — `td.Molecule.from_smiles(...)` in
# feature_utils — plus two readouts and an MLP. All four are reimplemented in
# `tankbind_features.py` and in GATv2/GINv2 directly, verified to produce bit-identical
# embeddings. Removing it also removes everything it dragged along: a C++ toolchain, a
# crypt.h symlink into conda's headers, a sed patch for `torch._six`, ninja, and a
# pre-warmed JIT extension.
RUN pip install --no-cache-dir \
        "atom3d==0.2.6" \
        "torchmetrics==1.5.2" \
        "numpy<2" \
        pandas scipy tqdm

WORKDIR /work
COPY . /work

# Assert the feature dimensions, not just that the imports resolve: the whole risk in this
# port is a silently different feature space. 21/56 is what torchdrug 0.1.2 produced and what
# the published weights expect.
RUN python -c "import torch, torch_geometric, atom3d, sys; sys.path.insert(0, '/work'); \
import importlib.util as u; \
assert u.find_spec('torch_scatter') is None, 'torch_scatter crept back in'; \
assert u.find_spec('torch_sparse') is None, 'torch_sparse crept back in'; \
from rdkit import Chem; from tankbind_features import molecule_features; \
n, _e, _w, f = molecule_features('CCO'); \
assert (f.shape[-1], n.shape[-1]) == (21, 56), f'features are {f.shape[-1]}/{n.shape[-1]}, expected 21/56'; \
print('env ok', torch.__version__, 'pyg', torch_geometric.__version__, \
'cuda', torch.version.cuda, 'features', f.shape[-1], n.shape[-1])"

# The encoder/head boundary. `linear` and `bias` were on the wrong side of it until
# 2026-09-09, which nothing would have reported: one is an entire head for the other task and
# the other is a single scalar.
RUN python test_transfer.py
